# Copy as .env file and fill your values below
# Run ./update_dotenv_example.sh to update .env-example from your .env file.

# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex
GOOGLE_GENAI_USE_VERTEXAI=0

# ML Dev backend config. Fill if using Ml Dev backend.
GOOGLE_API_KEY=

# Vertex backend config
GOOGLE_CLOUD_PROJECT=YOUR_VALUE_HERE
GOOGLE_CLOUD_LOCATION=YOUR_VALUE_HERE

# Values below this point are specific to MLE-STAR

# Models used in Agents
ROOT_AGENT_MODEL='gemini-2.5-flash'

# API key for LiteLLM endpoint
BASE_MODEL='openai-gpt-oss-120b'   
API_ENDPOINT='http://localhost:8000/v1/chat/completions'  # vLLM endpoint on H100 cluster
API_KEY=
MAX_TOKENS=300
TOP_P=0.5
TEMPERATURE=0.5

# Backend toggle
USE_LITELLM=0  # 1 = OpenAI-compatible API via LiteLLM, 0 = Gemini (requires GOOGLE_API_KEY)

# Skrub settings
USE_SKRUB_PIPELINES=0  # 1 = use skrub DataOps pipelines, 0 = default sklearn/pytorch
USE_SKRUB_RAG=0         # 1 = enable skrub docs RAG tool, 0 = disable

# --- RAG technique toggles (only used when USE_SKRUB_RAG=1) ---
RAG_CHUNKING=fixed      # fixed | structural (RST sections + Python AST + numpydoc)
RAG_RETRIEVAL=dense     # dense | hybrid (BM25 + dense fused with Reciprocal Rank Fusion)
RAG_TOKEN_BUDGET=2000   # max tokens of retrieved context handed to the LLM
RAG_MIN_SCORE=0.2       # dense cosine floor for candidate filtering
# Baseline = fixed + dense. The report's "second technique" = structural + hybrid.
# EMBED_MODEL=qwen3-embedding:8b   # embedding model for the index (rebuild index on change)

# --- External web source via SearXNG (hybrid retrieval only; off by default) ---
RAG_WEB=0                        # 1 = add SearXNG web results as a third fusion source
SEARXNG_URL=                     # e.g. http://localhost:8080 (self-hosted SearXNG, JSON format enabled)
RAG_WEB_TOP=10                   # SearXNG results requested before preprocessing
RAG_WEIGHTS=0.60,0.25,0.15       # context source priority: internal(dense),keyword(BM25),web

TASK='jigsaw-toxic-comment-classification-challenge'
